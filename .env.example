# BusRadar Environment Configuration (.env)
# Zero paid APIs required. Zero third-party tracker keys.

# Cryptographic secret for signing driver session tokens (HMAC-SHA256)
DRIVER_SIGNING_SECRET=generate_a_random_32_character_hex_secret_here

# Administrative passcode for registering buses, uploading routes, and maintenance
ADMIN_PASSCODE=ChangeMeToAStrongAdminPassword2024!

# Allowed CORS Origin (Use * for local development, or your Render URL in production)
# Example: https://busradar-bre5.onrender.com
ALLOWED_ORIGIN=*

# Server Port (Render injects PORT automatically)
PORT=8000
